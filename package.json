{
	"name": "verovio-music-renderer",
	"version": "1.1.5-beta.1",
	"description": "Rendering of music notation files.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"lint": "eslint .",
		"test": "node --test tests/*.test.mjs",
		"release:check": "npm run lint && npm run build",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@microsoft/eslint-plugin-sdl": "^1.1.0",
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "^8.71.1",
		"@typescript-eslint/parser": "^8.71.1",
		"esbuild": "0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-no-unsanitized": "^4.1.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "1.14.4",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3"
	},
	"overrides": {
		"eslint-plugin-obsidianmd": {
			"obsidian": {
				"moment": "2.31.0"
			}
		}
	},
	"dependencies": {
		"@codemirror/lang-xml": "^6.1.0",
		"@codemirror/language": "^6.13.1",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"codemirror": "^6.0.2",
		"lz-midi": "^0.0.1",
		"sax": "^1.6.1",
		"verovio": "^6.3.0"
	}
}
